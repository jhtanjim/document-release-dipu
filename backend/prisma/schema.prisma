generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// Direct (non-pooled) connection for migrations; Neon on Vercel sets both.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// SUPER_ADMIN: exactly one, from .env; creates and manages every other account.
/// ADMIN: everything except accounts. OPERATOR: enters and updates jobs.
enum Role {
  SUPER_ADMIN
  ADMIN
  OPERATOR
}

enum ContainerSize {
  FT20
  FT40
}

model User {
  id               Int               @id @default(autoincrement())
  name             String
  email            String            @unique
  passwordHash     String
  role             Role              @default(OPERATOR)
  active           Boolean           @default(true)
  /// Admins only: how many operator accounts this admin may open. Raised by the super admin.
  operatorLimit    Int               @default(1)
  createdById      Int?
  createdBy        User?             @relation("CreatedUsers", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers     User[]            @relation("CreatedUsers")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  auditLogs        AuditLog[]
  operatorRequests OperatorRequest[]
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// An admin asking the super admin for permission to open one more operator account.
model OperatorRequest {
  id        Int           @id @default(autoincrement())
  adminId   Int
  admin     User          @relation(fields: [adminId], references: [id], onDelete: Cascade)
  note      String?
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())
  decidedAt DateTime?

  @@index([status])
}

/// Single row (id = 1): the software subscription, managed by the super admin.
/// When it runs out without auto-renew, everyone except the super admin is locked out.
model Subscription {
  id           Int      @id @default(1)
  plan         String   @default("মাসিক")
  periodMonths Int      @default(1)
  /// Taka per period, shown for reference
  amount       Int?
  startedAt    DateTime @db.Date
  endsAt       DateTime @db.Date
  autoRenew    Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

model SubscriptionEvent {
  id        Int      @id @default(autoincrement())
  /// RENEW_AUTO, RENEW_MANUAL or UPDATE
  type      String
  fromDate  DateTime @db.Date
  toDate    DateTime @db.Date
  createdAt DateTime @default(now())
}

model Importer {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  jobs      Job[]
}

model ShippingAgent {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  jobs      Job[]
}

/// One job = one master file of containers whose guarantee (security money) is tracked until release.
model Job {
  id                 Int           @id @default(autoincrement())
  jobNo              String        @unique
  cNumber            String?       @unique
  importerId         Int
  importer           Importer      @relation(fields: [importerId], references: [id])
  agentId            Int
  agent              ShippingAgent @relation(fields: [agentId], references: [id])
  containerCount     Int
  containerSize      ContainerSize @default(FT20)
  /// Taka per container, whole numbers only
  ratePerContainer   Int
  depotReceivedAt    DateTime?     @db.Date
  surveyReceivedAt   DateTime?     @db.Date
  submittedToAgentAt DateTime?     @db.Date
  agentBillAt        DateTime?     @db.Date
  /// Taka, from the shipping agent's bill
  actualCost         Int?
  releasedAt         DateTime?     @db.Date
  note               String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  auditLogs          AuditLog[]

  @@index([importerId])
  @@index([agentId])
}

/// Single row (id = 1): default rate and the day limits behind the red marks.
model Setting {
  id          Int      @id @default(1)
  defaultRate Int      @default(10000)
  surveyDays  Int      @default(7)
  billDays    Int      @default(7)
  releaseDays Int      @default(30)
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  jobId     Int?
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  jobNo     String
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  changes   Json?
  createdAt DateTime @default(now())

  @@index([jobId])
}

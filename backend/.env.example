# PostgreSQL connection string (Neon, Supabase, Railway or your own server)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/guarantee_release?schema=public"
# Long random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
JWT_SECRET=""
PORT=4000
# Frontend address(es), comma separated
FRONTEND_URL="http://localhost:3000"
# First admin account, created by `npm run db:seed` if it does not exist yet
ADMIN_NAME="Admin"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# true = also add 12 sample jobs (testing only, never on the live database)
SEED_DEMO=false
